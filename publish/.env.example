# Copy to .env (git-ignored) and fill in. Never commit real values.
# Meta: System User or long-lived token with pages_show_list, pages_manage_posts,
#       instagram_basic, instagram_content_publish
META_ACCESS_TOKEN=
IG_USER_ID=
FB_PAGE_ID=
# YouTube: OAuth "Desktop app" client from Google Cloud (YouTube Data API v3 enabled)
YT_CLIENT_SECRET=client_secret.json
